generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                    String    @id
  shop                  String
  state                 String
  isOnline              Boolean   @default(false)
  scope                 String?
  expires               DateTime?
  accessToken           String
  userId                BigInt?
  firstName             String?
  lastName              String?
  email                 String?
  accountOwner          Boolean   @default(false)
  locale                String?
  collaborator          Boolean?  @default(false)
  emailVerified         Boolean?  @default(false)
  refreshToken          String?
  refreshTokenExpiresAt DateTime?

  @@index([shop])
}

model Merchant {
  id           String             @id @default(cuid())
  shop         String             @unique
  shopName     String?
  installedAt  DateTime           @default(now())
  uninstalledAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  orders       ShippingOrder[]
  costs        ShippingCost[]
  auditEvents  AuditEvent[]
  syncState    ShopifySyncState?
  simulations  PolicySimulation[]
  valueRecords  EconomicValueRecord[]
  scheduledSyncState ScheduledSyncState?
  reviewCases   ShippingReviewCase[]
}

model ShopifySyncState {
  id               String   @id @default(cuid())
  merchantId       String   @unique
  afterCursor      String?
  hasMore          Boolean  @default(false)
  pagesProcessed   Int      @default(0)
  ordersProcessed  Int      @default(0)
  lastPageAt       DateTime?
  lastCompletedAt  DateTime?
  lastError        String?
  updatedAt        DateTime @updatedAt
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model ShippingOrder {
  id                   String   @id @default(cuid())
  merchantId           String
  sourceOrderId        String
  orderName            String
  orderedAt            DateTime
  currency             String
  shippingRevenueMinor BigInt
  taxesIncluded         Boolean  @default(false)
  subtotalMinor        BigInt?
  costCoverageStatus   String   @default("unknown")
  coverageReviewedAt   DateTime?
  coverageReviewedBy   String?
  trackingNumbers      Json?
  sourcePayload        Json?
  ingestedAt           DateTime @default(now())
  merchant             Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, sourceOrderId])
  @@index([merchantId, orderedAt])
}

model ShippingCost {
  id              String   @id @default(cuid())
  merchantId      String
  sourceSystem    String
  sourceRecordId  String
  orderReference  String?
  trackingNumber  String?
  currency        String
  amountMinor     BigInt
  costType        String
  occurredAt      DateTime?
  sourceReference String?
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, sourceSystem, sourceRecordId])
  @@index([merchantId, orderReference])
  @@index([merchantId, trackingNumber])
}

model AuditEvent {
  id          String   @id @default(cuid())
  merchantId  String
  actor       String
  action      String
  subjectType String
  subjectId   String
  detail      Json?
  createdAt   DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
}

model WebhookReceipt {
  id          String   @id @default(cuid())
  shop        String
  webhookId   String   @unique
  topic       String
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  status      String   @default("received")

  @@index([shop, topic, receivedAt])
}

model PolicySimulation {
  id                          String   @id @default(cuid())
  merchantId                  String
  currency                    String
  flatRateMinor               BigInt
  freeShippingThresholdMinor  BigInt?
  sampleSize                  Int
  sampleWindowStart           DateTime?
  sampleWindowEnd             DateTime?
  observedShippingRevenueMinor BigInt
  replayedShippingRevenueMinor BigInt
  revenueDeltaMinor           BigInt
  assumptions                 Json
  warning                     String
  engineVersion               String   @default("v1")
  createdAt                   DateTime @default(now())
  merchant                    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
}

model EconomicValueRecord {
  id                    String   @id @default(cuid())
  merchantId            String
  category              String
  status                String   @default("identified")
  amountMinor           BigInt
  currency              String
  sourceReference       String
  realizationReference String?
  evidenceNote          String
  occurredAt            DateTime?
  createdBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  merchant              Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status, currency])
  @@index([merchantId, createdAt])
}

model ScheduledSyncState {
  id            String   @id @default(cuid())
  merchantId    String   @unique
  status        String   @default("scheduled")
  nextRunAt     DateTime @default(now())
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  failureCount  Int      @default(0)
  lastError     String?
  lockedUntil   DateTime?
  updatedAt     DateTime @updatedAt
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
}


model ShippingReviewCase {
  id          String   @id @default(cuid())
  merchantId  String
  fingerprint String
  orderId     String
  title       String
  severity    String
  explanation String
  status      String   @default("open")
  active      Boolean  @default(true)
  note        String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, fingerprint])
  @@index([merchantId, status, lastSeenAt])
}

// Independent merchant workspace: does not require Shopify OAuth to begin onboarding.
model ThreePLWorkspace {
  id                 String   @id @default(cuid())
  businessName       String
  ownerName          String
  ownerEmail         String
  shopDomain         String?
  status             String   @default("pending") // pending, onboarding, trial, active, suspended, closed
  planCode           String?
  trialActivatedAt   DateTime?
  trialEndsAt        DateTime?
  subscriptionStatus String   @default("none") // none, active, past_due, cancelled
  subscriptionStartedAt DateTime?
  subscriptionEndsAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  providers          ThreePLProvider[]
  contracts          ThreePLContract[]
  invoices           ThreePLInvoice[]
  activityRecords    ThreePLActivityRecord[]
  reconciliationRuns ThreePLReconciliationRun[]
  exceptions         ThreePLException[]
  caseEvents         ThreePLCaseEvent[]
  periodReports      ThreePLPeriodReport[]
  outcomes           ThreePLOutcome[]

  @@index([ownerEmail])
  @@index([status, trialEndsAt])
}

model ThreePLProvider {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  externalRef String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contracts   ThreePLContract[]
  invoices    ThreePLInvoice[]
  activityRecords ThreePLActivityRecord[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model ThreePLContract {
  id             String   @id @default(cuid())
  workspaceId    String
  providerId     String
  name           String
  currency       String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  status         String   @default("draft")
  sourceFileName String?
  sourceHash     String?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       ThreePLProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rateRules      ThreePLRateRule[]

  @@index([workspaceId, providerId, effectiveFrom])
}

model ThreePLRateRule {
  id            String   @id @default(cuid())
  contractId    String
  chargeCode    String
  unit          String
  pricing       String
  rateMinor     BigInt
  currency      String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contract      ThreePLContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, chargeCode, effectiveFrom])
}

model ThreePLInvoice {
  id             String   @id @default(cuid())
  workspaceId    String
  providerId     String
  invoiceNumber  String
  invoiceDate    DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime?
  currency       String
  totalMinor     BigInt
  status         String   @default("imported")
  sourceFileName String?
  sourceHash     String?
  importedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       ThreePLProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  lines          ThreePLInvoiceLine[]
  runs           ThreePLReconciliationRun[]
  exceptions     ThreePLException[]

  @@unique([workspaceId, providerId, invoiceNumber])
  @@index([workspaceId, invoiceDate])
  @@index([workspaceId, status, periodStart])
}

model ThreePLInvoiceLine {
  id                String   @id @default(cuid())
  invoiceId         String
  externalLineId    String?
  chargeCode        String
  description       String?
  quantity          Decimal  @db.Decimal(18, 3)
  unit              String
  amountMinor       BigInt
  currency          String
  activityReference String?
  sourceRow         Int
  createdAt         DateTime @default(now())
  invoice           ThreePLInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  exceptions        ThreePLException[]

  @@index([invoiceId, chargeCode])
  @@index([invoiceId, activityReference])
}

model ThreePLActivityRecord {
  id             String   @id @default(cuid())
  workspaceId    String
  providerId     String
  sourceSystem   String
  sourceRecordId String
  reference      String
  chargeCode     String
  quantity       Decimal  @db.Decimal(18, 3)
  unit           String
  occurredAt     DateTime?
  sourceRow      Int
  createdAt      DateTime @default(now())
  workspace      ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       ThreePLProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceSystem, sourceRecordId])
  @@index([workspaceId, reference, chargeCode])
  @@index([workspaceId, occurredAt])
}

model ThreePLReconciliationRun {
  id           String   @id @default(cuid())
  workspaceId  String
  invoiceId    String
  engineVersion String
  inputHash    String
  status       String   @default("completed")
  summary      Json
  createdAt    DateTime @default(now())
  workspace    ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice      ThreePLInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  exceptions   ThreePLException[]

  @@unique([workspaceId, invoiceId, inputHash])
  @@index([workspaceId, createdAt])
}

model ThreePLException {
  id                 String   @id @default(cuid())
  workspaceId        String
  invoiceId          String
  runId              String
  invoiceLineId      String?
  fingerprint        String
  findingCode        String
  severity           String
  state              String
  status             String   @default("open")
  exposureMinor      BigInt?
  currency           String
  explanation        String
  evidenceReferences Json
  assignedTo         String?
  dueAt              DateTime?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice            ThreePLInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  run                ThreePLReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  invoiceLine        ThreePLInvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  events             ThreePLCaseEvent[]
  outcomes           ThreePLOutcome[]

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status, severity, lastSeenAt])
  @@index([workspaceId, invoiceId])
}

model ThreePLCaseEvent {
  id          String   @id @default(cuid())
  workspaceId String
  exceptionId String
  actorType   String
  actorRef    String?
  action      String
  detail      Json?
  createdAt   DateTime @default(now())
  workspace   ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exception   ThreePLException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, exceptionId, createdAt])
}

model ThreePLPeriodReport {
  id          String   @id @default(cuid())
  workspaceId String
  periodStart DateTime
  periodEnd   DateTime
  revision    Int      @default(1)
  status      String   @default("draft")
  payload     Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  workspace   ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, periodEnd, revision])
  @@index([workspaceId, periodEnd])
}

model ThreePLOutcome {
  id                 String   @id @default(cuid())
  workspaceId        String
  exceptionId        String
  outcomeType        String
  status             String   @default("identified") // identified, raised, promised, posted, verified, rejected
  amountMinor        BigInt
  currency           String
  externalReference  String?
  evidenceNote       String
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exception          ThreePLException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, currency])
  @@index([workspaceId, exceptionId])
}


model ThreePLAccessToken {
  id          String   @id @default(cuid())
  workspaceId String
  tokenHash   String   @unique
  label       String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  workspace   ThreePLWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt, expiresAt])
}
model ThreePLLead {
  id             String   @id @default(cuid())
  name           String
  email          String
  shopDomain     String
  monthlyOrders  String
  fulfilmentSetup String
  objective      String
  requestedOffer String   @default("seven_day_trial")
  consentAt      DateTime
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([shopDomain, createdAt])
}
