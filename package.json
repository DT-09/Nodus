{
  "name": "nodus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "start:prod": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma db push",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && react-router build"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@vercel/react-router": "^1.3.7",
    "prisma": "^6.16.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "deepmerge-ts": "^8.0.2"
  }
}
