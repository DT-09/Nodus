SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,read_products,read_fulfillments,read_shipping,read_markets
DATABASE_URL=postgresql://USER:PASSWORD@POOLER-HOST:6543/nodus?schema=public&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST:5432/nodus?schema=public
PUBLIC_CONTACT_EMAIL= # Required in production; monitored business-owned support inbox
NODE_ENV=development
CRON_SECRET= # Production: at least 32 random characters; never commit a real value

# Shopify App Pricing (enable only after plans are configured in the Partner Dashboard)
SHOPIFY_APP_PRICING_ENABLED=false
SHOPIFY_APP_HANDLE=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=
NODUS_PLAN_EVIDENCE_HANDLE=
NODUS_PLAN_CONTROL_HANDLE=
NODUS_PLAN_PORTFOLIO_HANDLE=
